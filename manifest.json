{
  "manifest_version": 3,
  "name": "BookmArc",
  "version": "0.7.6",
  "description": "Your Firefox bookmarks as an Arc-style sidebar: the bookmarks toolbar as pinned tabs with folders and colors, favorites, your open tabs and a command bar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmarc@pliha",
      "strict_min_version": "155.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "theme",
    "alarms",
    "storage",
    "sessions",
    "menus",
    "clipboardWrite",
    "history",
    "search",
    "topSites",
    "bookmarks",
    "contextualIdentities",
    "cookies",
    "tabHide",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Toggle BookmArc",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "sidebar_action": {
    "default_title": "BookmArc",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": true
  },
  "commands": {
    "new-tab": {
      "suggested_key": {
        "default": "Ctrl+T",
        "mac": "Command+T"
      },
      "description": "Open the command bar"
    },
    "open-location": {
      "suggested_key": {
        "default": "Ctrl+L",
        "mac": "Command+L"
      },
      "description": "Open the command bar with the current tab's address"
    },
    "close-tab": {
      "suggested_key": {
        "default": "Ctrl+W",
        "mac": "Command+W"
      },
      "description": "Close the current tab"
    },
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open BookmArc"
    },
    "add-favorite": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Add current tab to Favorites"
    },
    "space-1": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "Switch to space 1"
    },
    "space-2": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "Switch to space 2"
    },
    "space-3": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "Switch to space 3"
    },
    "reopen-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+T"
      },
      "description": "Reopen the tab closed last in this space"
    },
    "space-4": {
      "suggested_key": {
        "default": "Alt+4"
      },
      "description": "Switch to space 4"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  }
}
