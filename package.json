{
  "name": "bookmarc",
  "version": "0.3.22",
  "private": true,
  "description": "Your Firefox bookmarks as an Arc-style sidebar: the bookmarks toolbar as pinned tabs with folders and colors, favorites, your open tabs and a command bar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:chokity/BookmArc.git"
  },
  "type": "module",
  "scripts": {
    "dev": "open -na \"Firefox Developer Edition\" --args --profile \"$HOME/Library/Application Support/Firefox/Profiles/bookmarc-dev\" --start-debugger-server 6005",
    "lint": "web-ext lint --self-hosted",
    "build": "web-ext build --overwrite-dest",
    "sign": "./sign.sh",
    "sign:listed": "./sign.sh --listed",
    "reload": "node scripts/reload.mjs",
    "build:setup": "node scripts/build-setup.mjs",
    "setup-dev": "bash scripts/setup-dev-profile.sh",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  }
}
